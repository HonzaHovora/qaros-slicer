{
  "version": 3,
  "configurePresets": [
    {
      "name": "core",
      "displayName": "Portable core without VTK / QAROS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-core",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "QARVTK_BUILD_RENDERER": "OFF"}
    },
    {
      "name": "linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    }
  ],
  "buildPresets": [
    {"name": "core", "configurePreset": "core"},
    {"name": "linux", "configurePreset": "linux"}
  ],
  "testPresets": [
    {"name": "core", "configurePreset": "core", "output": {"outputOnFailure": true}},
    {"name": "linux", "configurePreset": "linux", "output": {"outputOnFailure": true}}
  ]
}
